# NIRANTAR Environment Configuration
# ==================================

# Database & Cache (Local Defaults)
DATABASE_URL=sqlite:///./nirantar.db
# DATABASE_URL=postgresql://nirantar:nirantar_secret@localhost:5432/nirantar_db
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (Local Default: ₹0 Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Optional Cloud LLM Keys (Only needed if LLM_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & Secrets
JWT_SECRET_KEY=nirantar_development_secret_key_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
