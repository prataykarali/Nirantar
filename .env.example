# ==============================================================================
# NIRANTAR — FULL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- System & Deployment Environment ---
ENVIRONMENT=production
CORS_ORIGINS=*
FAIR_ACCESS_ENABLED=true
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# --- Database & Server ---
DATABASE_URL=sqlite+aiosqlite:///./nirantar.db
HOST=0.0.0.0
PORT=8000

# --- Primary LLM Provider & NVIDIA NIM Configuration ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=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
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# --- Secondary LLM Providers ---
GEMINI_API_KEY=disabled
OPENAI_API_KEY=disabled

# --- Apify RAG & Web Search Engine ---
APIFY_ACTOR_ID=crawlerbros/rag-web-browser
APIFY_API_TOKEN=apify_api_token_placeholder
APIFY_CACHE_TTL_HOURS=24
APIFY_RATE_LIMIT_PER_MINUTE=30

# --- Scrapling Statutory Grounding & Ingestion Pipeline ---
RAILWAY_INFO_SOURCE=scrapling
SCRAPLING_CACHE_TTL_HOURS=24
RAILWAY_OFFICIAL_API_URL=https://enquiry.indianrail.gov.in

# --- Voice & Speech Services (Murf TTS & Deepgram STT) ---
MURF_API_KEY=ap2_e02822c1-60a7-4cb2-95cb-f7f60445cf92
DEEPGRAM_API_KEY=d4ce071a8da028082bacade9f4708be3dfa7287f

# --- Simulation / Load Testing (PRAYOG Engine) ---
PRAYOG_SCENARIO=DIWALI_RUSH

# --- Frontend Client Environment Variables (Vite) ---
VITE_API_URL=/api/v1
VITE_NVIDIA_API_KEY=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
VITE_NVIDIA_MODEL=meta/llama-3.1-70b-instruct
VITE_NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
VITE_MURF_API_KEY=ap2_e02822c1-60a7-4cb2-95cb-f7f60445cf92
VITE_DEEPGRAM_API_KEY=d4ce071a8da028082bacade9f4708be3dfa7287f
