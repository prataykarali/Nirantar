# ═══════════════════════════════════════════════════════════════════
# NIRANTAR (निरंतर) — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════

# ─── 1. SERVER & RUNTIME ───
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
CORS_ORIGINS=*

# ─── 2. PERSISTENT DATABASE ───
# SQLite (Local Dev / Docker Default) or PostgreSQL URL
DATABASE_URL=sqlite:///./nirantar_journey.db
# Example Postgres: postgresql://postgres:postgres@localhost:5432/nirantar

# ─── 3. AI & LLM PROVIDER (NVIDIA / OLLAMA / GEMINI) ───
# NIRANTAR operates 100% locally with zero paid API lock-in.
# If NVIDIA_API_KEY is omitted, local deterministic SafeMode automatically handles all flows.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Optional Cloud Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── 4. VOICE & TTS ENGINE ───
# Built-in browser Web Speech API + 4-tone Indian Railway chime works offline with no key.
MURF_API_KEY=ap2_e02822c1-60a7-4cb2-95cb-f7f60445cf92
DEEPGRAM_API_KEY=d4ce071a8da028082bacade9f4708be3dfa7287f

# ─── 5. EXTERNAL INGESTION & SEARCH (OPTIONAL ADAPTERS) ───
APIFY_API_TOKEN=
APIFY_ACTOR_ID=crawlerbros/rag-web-browser
APIFY_CACHE_TTL_HOURS=24
APIFY_RATE_LIMIT_PER_MINUTE=20
SCRAPLING_CACHE_TTL_HOURS=24
RAILWAY_INFO_SOURCE=scrapling

# ─── 6. FAIR ACCESS & LOAD CONTROL ───
FAIR_ACCESS_ENABLED=true
MAX_QUEUE_CAPACITY=10000

# ─── 7. FRONTEND VITE ENVIRONMENT ───
# Used when deploying frontend separately (e.g., on Vercel)
# Leave empty for relative proxy (/api/v1)
VITE_API_URL=
