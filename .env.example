# NIRANTAR Environment Configuration Example
# ============================================

# 1. Thin LLM Layer (NVIDIA NIM / OpenAI-compatible endpoint)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# 2. Responsible AI & Fair Access Anti-Scammer Layer
FAIR_ACCESS_ENABLED=true
RATE_LIMIT_BURST_MAX=15
RATE_LIMIT_WINDOW_SECONDS=10
IDEMPOTENCY_CACHE_TTL_MINUTES=15

# 3. Server Runtime & Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
CORS_ORIGINS=*
DATABASE_URL=sqlite:///./m0_digital_twin.db

# 4. Frontend Client Configuration (empty for relative /api/v1 in production/Vercel)
VITE_API_URL=
# For local dev with separate ports, set: VITE_API_URL=http://localhost:8000

# 5. Voice & Speech Services (Web Speech API / Cloud TTS)
MURF_API_KEY=your_murf_api_key_optional
DEEPGRAM_API_KEY=your_deepgram_api_key_optional
VITE_MURF_API_KEY=your_murf_api_key_optional
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_optional
