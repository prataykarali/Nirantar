# AI Agent Company — Project Configuration
# Automatically resolves relative to project root or COMPANY_BUGS_PATH

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || pwd)"
COMPANY_BUGS_PATH="${COMPANY_BUGS_PATH:-${PROJECT_ROOT}/.company}"
COMPANY_NAME="AI Agent Company"
COMPANY_VERSION="2.0.0"

# Agent Configuration
AGENT_ARCHITECT_ENABLED=true
AGENT_LEAD_DEV_ENABLED=true
AGENT_ML_SPECIALIST_ENABLED=true
AGENT_QA_ENABLED=true
AGENT_REVIEWER_ENABLED=true
AGENT_FILE_WARDEN_ENABLED=true
AGENT_UI_DESIGNER_ENABLED=true
AGENT_UX_RESEARCHER_ENABLED=true

# Tooling Integration
TOOLING_GRATIFY_ENABLED=true
TOOLING_HEADROOM_ENABLED=true
TOOLING_PONYTAIL_ENABLED=true
TOOLING_OBSIDIAN_ENABLED=true
TOOLING_CODERABBIT_ENABLED=true
TOOLING_OCTOREVIEW_ENABLED=true
TOOLING_GITSTREAM_ENABLED=true

# Design Configuration
DESIGN_TOKENS_PATH="${COMPANY_BUGS_PATH}/templates/design_handoff_spec.md"
UX_AUDIT_PATH="${COMPANY_BUGS_PATH}/templates/ux_audit_report.md"
OBSIDIAN_VAULT_PATH="${PROJECT_ROOT}/.company/obsidian"

# Pipeline Configuration
MAX_ITERATIONS=3
SKIP_QA=false
VERBOSE=false

# File Governance
MAX_FILE_LINES=500
WARN_FILE_LINES=450
MIN_FILE_LINES=10
TARGET_FILE_LINES=400

# LLM Evaluation Defaults
MIN_OUTPUT_CHARS=180
MIN_CITATIONS=3
MIN_GOOD_MODEL_CHARS=180

# Directories
COMPANY_AGENTS_DIR="${COMPANY_BUGS_PATH}/agents"
COMPANY_PIPELINES_DIR="${COMPANY_BUGS_PATH}/pipelines"
COMPANY_RULES_DIR="${COMPANY_BUGS_PATH}/rules"
COMPANY_TEMPLATES_DIR="${COMPANY_BUGS_PATH}/templates"
COMPANY_SCRIPTS_DIR="${COMPANY_BUGS_PATH}/scripts"
COMPANY_EVALS_DIR="${COMPANY_BUGS_PATH}/evals"

# Banner
COMPANY_BANNER="
╔═══════════════════════════════════════════════════════╗
║  🏢 AI Agent Company v${COMPANY_VERSION}                          ║
║  8-Agent Workforce + Advanced Tooling Ecosystem      ║
╚═══════════════════════════════════════════════════════╝
"
