{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/nira/chat/stream", "destination": "/api/chat" },
    { "source": "/api/v1/:match*", "destination": "/api/[[...path]]" },
    { "source": "/api/:match*", "destination": "/api/[[...path]]" }
  ]
}
